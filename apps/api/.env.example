# SIGEA API — Variáveis de Ambiente de Exemplo
# NUNCA coloque credenciais de produção ou secrets neste ficheiro

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_URL=http://localhost:3000

# PostgreSQL Connection String (Exemplo local / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sigea_dev?schema=public"

# CORS Origins permitidos (separados por vírgula se múltiplos)
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Nível de Log do Fastify (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info
