// SIGEA — Schema Prisma Inicial (Fundação Multi-Tenant)
// Este schema define os modelos estruturais iniciais.
// Não executar migrations destrutivas nesta fase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  STARTER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  PARTNER
  LAWYER
  PARALEGAL
  INTERN
  FINANCIAL
  SECRETARY
  CLIENT
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  EXPORT
  READ_CONFIDENTIAL
}

// Organização / Escritório de Advocacia (Tenant)
model Organization {
  id               String           @id @default(uuid())
  name             String
  nif              String           @unique
  email            String
  phone            String?
  address          String?
  city             String?          @default("Luanda")
  country          String           @default("Angola")
  subscriptionTier SubscriptionTier @default(STARTER)
  maxUsers         Int              @default(10)
  storageLimitGb   Int              @default(50)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  users            User[]
  auditLogs        AuditLog[]

  @@map("organizations")
}

// Utilizadores da Plataforma e dos Escritórios
model User {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  email          String       @unique
  passwordHash   String
  role           UserRole     @default(LAWYER)
  oaaNumber      String?      // Cédula OAA
  phone          String?
  avatarUrl      String?
  isActive       Boolean      @default(true)
  department     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditLogs      AuditLog[]

  @@index([organizationId])
  @@map("users")
}

// Trilha de Auditoria Forense
model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  userRole       UserRole?
  action         AuditAction
  entity         String
  entityId       String
  details        String?
  ipAddress      String?
  userAgent      String?
  timestamp      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([timestamp])
  @@map("audit_logs")
}
